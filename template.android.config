# Android Project Configuration Template
# Place this file as <project-name>.android.config in your config directory or project root.

# === PROJECT CONFIGURATION ===
project_name=Essentials
project_dir=/Users/sameerasandakelum/GIT/essentials
workspace_file=/Users/sameerasandakelum/GIT/config/essentials.code-workspace
package_name=com.sameerasw.essentials
main_activity=.MainActivity

# Build task (e.g. assembleDebug, installDebug, bundleRelease)
gradle_task=assembleDebug

# Relative path inside project to built APK (optional, auto-detected if empty)
# apk_path=app/build/outputs/apk/debug/app-debug.apk

# Build variant (debug or release)
build_variant=debug

# Target device serial / IP:PORT (leave empty to prompt or auto-select if only 1 device connected)
target_device=

# Logcat tag filters (comma-separated, leave empty for all tags for this package)
# log_tags=Essentials,MainActivity,AirSync
